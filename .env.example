# Copy to .env and replace every placeholder. Never commit .env.
# The backend reads this file automatically when run locally; real
# environment variables take precedence over values here.

# --- MySQL server (backend) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=pim
# Separate database used only by ./mvnw test. Never point this at real data.
MYSQL_TEST_DATABASE=pim_test
MYSQL_USER=pim
MYSQL_PASSWORD=change-me
# DISABLED | PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY
# Use REQUIRED (or stricter) when MySQL runs on another machine.
MYSQL_SSL_MODE=PREFERRED

# --- Backend ---
SERVER_PORT=8080

# --- Docker only (docker-compose.yml, currently not used) ---
MYSQL_ROOT_PASSWORD=change-me-root
